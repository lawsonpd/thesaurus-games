{
    "version": 2,
    "builds": [
        {
            "src": "api/index.py",
            "use": "@vercel/python",
            "config": { 
                "runtime": "python3.9",
                "maxLambdaSize": "15mb",
                "pip": ["flask==3.0.2", "requests==2.31.0", "itsdangerous==2.1.2"]
            }
        }
    ],
    "routes": [
        {
            "src": "/(.*)",
            "dest": "api/index.py"
        }
    ]
} 